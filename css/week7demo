@font-face {
    font-family: 'Roboto';
    src: url("fonts/Roboto-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

:root {
  /* color */
	--color-background: #fcfcfc;
	--color-foreground: #2d2e2f;
    --color-overlay-dark: #04182b;
    --color-overlay-light: #f5f5f5;
	--color-link: #526605;
	--color-link-hover: #073e42;
  --color-focus-ring: #100742;
  /* font size */
  --font-serif: 'Roboto', system-ui, sans-serif;
  --font-size-small: 0.875rem;
  --font-size-base: 1rem;
  --font-size-large: 1.25rem;
  --font-size-h3: 1.75rem;
  --font-size-h2: 2rem;
  --font-size-h1: 2.25rem;
  /* line spacing */
  --line-height-base: 1.5;
  --line-height-heading: 1.2;
  --max-width: 50ch;

body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(font-serif);
    font-size: 130%
  }
img {
    width: 100%;
    height: auto;
    /* all images */
  }
.mast {
    margin: 0 auto;
    max-width: 1100px;

    img {
        filter: drop-shadow(8px 8px 10px var(--color-overlay-dark));
        /* can nest selectors or break them out */
    }
}

.wrapper {
    margin: 0 auto;
    max-width: 65ch;
}

b {
    color: var(--color-foreground);
    font-weight: bold;
}

h1 {
    color: var(--color-foreground);
    font-size: 20vh;
    line-height: var(--line-height-heading);
    letter-spacing: -0.05em;
    margin-top: var(--line-height-heading);
    padding: 0.5rem;
    text-align: center;
    text-transform: uppercase;
    text-wrap: pretty;

background: linear-gradient(90deg, var(--color-link), var(--color-link-hover));
-webkit-background-clip: text;
}

}